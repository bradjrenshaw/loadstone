{
  "manifestVersion": 1,
  "kind": "tool",
  "id": "lovely-injector",
  "name": "Lovely Injector",
  "description": "A runtime Lua injector for LOVE2D games. Loads mods from the game's Mods folder.",
  "authors": ["ethangreen-dev"],
  "license": "MIT",
  "source": "github:ethangreen-dev/lovely-injector",
  "conflictPolicy": "keep-newer",
  "pinnedRelease": {
    "version": "0.9.0",
    "artifacts": [
      {
        "file": "lovely-x86_64-pc-windows-msvc.zip",
        "sha256": "40b994a055ee75e5f2aba81e7ae06f2c17460e18cc346483089921899fadd1f7",
        "when": { "platform": "windows" }
      },
      {
        "file": "lovely-aarch64-apple-darwin.tar.gz",
        "sha256": "1eea194047eef0a27908f50be1c646571b97917bd597afd1ea0a30feaef68948",
        "when": { "platform": "macos", "arch": "arm64" }
      },
      {
        "file": "lovely-x86_64-apple-darwin.tar.gz",
        "sha256": "9704a34f0606ec54e1c3566cedf0d48c8741602a91cd4bf1b37d9e544ab1b6d3",
        "when": { "platform": "macos", "arch": "x64" }
      }
    ]
  },
  "install": [
    {
      "step": "extract-archive",
      "routes": [
        { "from": "version.dll", "to": "${gameDir}/version.dll", "when": { "platform": "windows" } },
        { "from": "liblovely.dylib", "to": "${gameDir}/liblovely.dylib", "when": { "platform": "macos" } }
      ]
    }
  ]
}
